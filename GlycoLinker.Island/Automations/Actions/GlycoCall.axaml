<ci:ActionSettingsControlBase x:Class="GlycoLinker.Island.Automations.Actions.GlycoCallSettings"
                              x:TypeArguments="local:GlycoCallConfig"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:local="clr-namespace:GlycoLinker.Island.Automations.Actions"
                              xmlns:ci="http://classisland.tech/schemas/xaml/core"
                               mc:Ignorable="d" d:DesignWidth="400"
                               x:CompileBindings="False">
    <StackPanel Orientation="Vertical" Spacing="8">
        <ci:Field Label="「G节点ID」">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <AutoCompleteBox x:Name="GidBox"
                                 ItemsSource="{Binding NodeIds}"
                                 Text="{Binding Settings.TargetGid, Mode=TwoWay}"
                                 MinWidth="220"
                                 HorizontalAlignment="Stretch"
                                 FilterMode="Contains"
                                 MinimumPrefixLength="0"
                                 LostFocus="GidBox_OnLostFocus"
                                 GotFocus="GidBox_OnGotFocus"
                                 SelectionChanged="GidBox_OnSelectionChanged">
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,2">
                                <TextBlock Text="{Binding Id}"  Margin="0,0,0,1"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" IsVisible="{Binding HasDetail}"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
                <Button Click="ButtonRefresh_OnClick" Content="刷新"/>
            </StackPanel>
        </ci:Field>
        <ci:Field Label="「结构域ID」">
            <StackPanel Orientation="Vertical" Spacing="4">
                <AutoCompleteBox x:Name="FidBox"
                                 ItemsSource="{Binding FieldIds}"
                                 Text="{Binding Settings.Fid, Mode=TwoWay}"
                                 MinWidth="220"
                                 HorizontalAlignment="Stretch"
                                 FilterMode="Contains"
                                 MinimumPrefixLength="0"
                                 LostFocus="FidBox_OnLostFocus"
                                 GotFocus="FidBox_OnGotFocus"
                                 SelectionChanged="FidBox_OnSelectionChanged">
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                    <TextBlock Text="{Binding Id}" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding HasFriendlyName}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
                <TextBlock Text="仅列出方法结构域"
                           Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </ci:Field>
        <ci:Field Label="参数">
            <StackPanel Orientation="Vertical" Spacing="6">
                <TextBlock x:Name="ParamNote" TextWrapping="Wrap" Opacity="0.6" IsVisible="False"/>
                <StackPanel x:Name="ParamForm" Orientation="Vertical" Spacing="6"/>
                <TextBox x:Name="JsonParamBox"
                         Text="{Binding Settings.PayloadJson, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         FontFamily="Consolas, Cascadia Mono"
                         TextChanged="JsonParamBox_OnTextChanged"/>
                <TextBlock x:Name="JsonParamError"
                           Foreground="OrangeRed"
                           FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="False"/>
            </StackPanel>
        </ci:Field>
    </StackPanel>
</ci:ActionSettingsControlBase>
